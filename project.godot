; Engine configuration file.
; Mở bằng Godot 4.4 trở lên.

config_version=5

[application]

config/name="Kamen Rider Chrono Henshin (fan game)"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
CombatDirector="*res://scripts/autoload/combat_director.gd"
Sound="*res://scripts/autoload/sound.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="hurtbox"
2d_physics/layer_5="platform"
2d_physics/layer_6="camera_wall"

[physics]

2d/default_gravity=1620.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
